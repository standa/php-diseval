{
    "name": "standa/diseval",
    "description": "Disables eval() in PHP 8 (PIE-installable wrapper around mk-j/PHP_diseval_extension)",
    "type": "php-ext",
    "license": "MIT",
    "keywords": [
        "eval",
        "security",
        "php-ext",
        "pie",
        "extension"
    ],
    "require": {
        "php": "^8.0"
    },
    "php-ext": {
        "extension-name": "diseval",
        "build-path": "source",
        "support-zts": true,
        "support-nts": true,
        "download-url-method": [
            "pre-packaged-binary",
            "composer-default"
        ],
        "os-families-exclude": [
            "windows"
        ]
    },
    "homepage": "https://github.com/standa/php-diseval"
}
